      {
        "name": "consult",
        "description": "Ask the person using this agent a question, and wait for their answer.\n\nUse this for something only they can settle: a preference, which of two readings was\nmeant, or permission to go ahead. Do not use it for anything findable with the other\ntools. Pass `options` to offer a choice rather than an open question. Pass `about` as a\nshort stable name for the thing the question is about, the same name every time it\ncomes up, so an answer arriving later can be matched to it. Returns their answer, or\nnothing if they declined to answer.",
        "input_schema": {
          "properties": {
            "question": {
              "title": "Question",
              "type": "string"
            },
            "options": {
              "anyOf": [
                {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Options"
            },
            "about": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "About"
            }
          },
          "required": [
            "question"
          ],
          "type": "object"
        }
      },
      {
        "name": "finish",
        "description": "Call this tool with the final answer. Its arguments are the answer itself and are validated against the required schema.\nA field that accepts `unknown` takes either form, and both are answers:\n  \"inseam_cm\": 81\n  \"inseam_cm\": {\"type\": \"unknown\", \"reason\": \"not listed on the page\"}\nSend the object, not the word. A guess presented as a fact is not an answer, and neither is the string \"unknown\" where the object belongs.",
        "input_schema": {
          "$defs": {
            "Unknown": {
              "description": "The value the field asks for, where the agent established that it is not available. Supply `reason` saying what was looked for and what was found instead.",
              "properties": {
                "type": {
                  "const": "unknown",
                  "default": "unknown",
                  "title": "Type",
                  "type": "string"
                },
                "reason": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "default": null,
                  "description": "What was looked for, and what was found instead.",
                  "title": "Reason"
                }
              },
              "title": "Unknown",
              "type": "object"
            }
          },
          "properties": {
            "decision": {
              "description": "approve where the vendor is an approved supplier; park where no one can settle it now; reject only where the claim breaks a rule outright.",
              "enum": [
                "approve",
                "reject",
                "park"
              ],
              "title": "Decision",
              "type": "string"
